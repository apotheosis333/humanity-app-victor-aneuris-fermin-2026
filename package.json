{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "backend:build": "pnpm --filter @workspace/api-server run build",
    "backend:start": "pnpm --filter @workspace/api-server run start",
    "backend:typecheck": "pnpm --filter @workspace/api-server run typecheck",
    "mobile:build": "pnpm --filter @workspace/humanity run mobile:build",
    "cap:copy": "pnpm --filter @workspace/humanity run cap:copy",
    "cap:sync": "pnpm --filter @workspace/humanity run cap:sync",
    "cap:add:android": "pnpm --filter @workspace/humanity run cap:add:android",
    "cap:add:ios": "pnpm --filter @workspace/humanity run cap:add:ios",
    "cap:open:android": "pnpm --filter @workspace/humanity run cap:open:android",
    "cap:open:ios": "pnpm --filter @workspace/humanity run cap:open:ios",
    "android:build:debug": "pnpm --filter @workspace/humanity run android:build:debug",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
